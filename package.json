{
  "name": "dsh-composer-enhance",
  "version": "0.1.0",
  "description": "Native DeepSeek Harness web plugin: a ✨ button in the composer that grounds a draft in session context, asks only about genuine ambiguity, rewrites the draft in place with a change list, then refines it on a slower second pass.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "prompt",
    "composer",
    "prompt-enhancement"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.6-alpha.2",
    "@types/react": "^18.3.12",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "license": "MIT"
}
